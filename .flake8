[flake8]
max-line-length = 88
ignore =
    E203,
    W503,
    E501,
    C901
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    .pytest_cache,
    .coverage,
    build,
    dist,
    docs,
    migrations,
    *.egg-info
filename = *.py
select =
    E,
    W,
    F,
    C,
    B
max-complexity = 10
show-source = True
format = default
per-file-ignores =
    __init__.py:F401
    tests/*:S101
